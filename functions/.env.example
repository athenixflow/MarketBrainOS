# Copy this file to `.env` (same folder) and fill in the real value.
# firebase-tools auto-loads functions/.env at deploy time and sets these as
# runtime environment variables on the Cloud Function.

# Which AI provider answers every analysis (functions/src/ai.ts): `gemini` (default) or
# `deepseek`. Switching is an edit here plus `firebase deploy --only functions`.
AI_PROVIDER=gemini

# Google Gemini API key (Generative Language API). Get one at:
#   https://aistudio.google.com/apikey
# Read by functions/src/ai.ts as process.env.API_KEY. SERVER-ONLY secret —
# never put this in the frontend / Vite build.
API_KEY=

# DeepSeek API key (https://platform.deepseek.com/api_keys), used when AI_PROVIDER=deepseek.
# SERVER-ONLY secret. DEEPSEEK_MODEL is optional (default deepseek-chat).
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Resend API key for transactional email (https://resend.com/api-keys).
# Read by functions/src/email/send.ts as process.env.RESEND_API_KEY.
# Use a SEND-ONLY restricted key. SERVER-ONLY secret — never expose to the frontend.
RESEND_API_KEY=
